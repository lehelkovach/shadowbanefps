# ShadowbaneFPS — required environment variable NAMES only (no values).
# Copy to .env (gitignored) and fill locally / via Cursor Dashboard → Secrets.
# NEVER commit PEM keys, API key material, or private SSH keys.

# --- OCI API auth (CLI / Terraform provider) ---
OCI_CLI_USER
OCI_CLI_TENANCY
OCI_CLI_FINGERPRINT
OCI_CLI_KEY_FILE
OCI_CLI_REGION
OCI_CLI_PROFILE

# Alternate names accepted by our scripts:
OCI_REGION
OCI_COMPARTMENT_OCID
OCI_COMPARTMENT_ID
OCI_TENANCY_OCID
OCI_USER_OCID

# Terraform (optional overrides; apply.sh also maps from OCI_* above)
TF_VAR_oci_region
TF_VAR_compartment_ocid
TF_VAR_ssh_public_key
TF_VAR_ssh_allowed_cidrs

# --- SSH / deploy ---
# Public key contents OR path to .pub file (private key stays on disk / Cursor secret)
SSH_PUBLIC_KEY
SSH_PUBLIC_KEY_FILE
SSH_ALLOWED_CIDRS
SB_SSH_USER
SB_SSH_IDENTITY
SSH_IDENTITY_FILE

# Host targeting for scripts/deploy-server.sh (prefer SSH config Host aliases)
SB_DEPLOY_HOST_DEV
SB_DEPLOY_HOST_RELEASE
SB_DEV_IP
SB_RELEASE_IP
SB_REMOTE_ROOT
SB_KEEP_RELEASES

# Live DEV (public, not secret) — set in local .env for deploy scripts:
#   SB_DEV_IP=144.24.46.16
#   SB_SSH_USER=ubuntu
# Client connect: 144.24.46.16:7777  (see docs/OCI_DEPLOY.md)

# Suggested ~/.ssh/config Host aliases (not env vars, documented here):
#   Host shadowbanefps-dev
#   Host shadowbanefps-release

# --- Deploy paths (local cooked output) ---
# Default cook archive from docs/SETUP.md / docs/OCI_DEPLOY.md:
#   Dist/Server/LinuxServer
SB_LOCAL_LINUXSERVER_DIR
