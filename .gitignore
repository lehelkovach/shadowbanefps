# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Script/
Platforms/*/Build/
Platforms/*/Binaries/

# Visual Studio / Rider / VS Code project files (regenerated from .uproject)
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.sln
*.suo
*.sdf
*.opensdf
*.xcodeproj
*.xcworkspace
.DS_Store

# Compiled binaries
*.dll
*.exe
*.pdb
*.obj
*.lib
*.a
*.so
*.dylib

# Crash/log artifacts
*.log
*.dmp

# Packaged / cooked output
/Packaged/
/Cooked/
/Dist/

# Parked marketplace / Fab dumps (kept out of Content so Editor/PIE do not scan them)
_ParkedContent/

# Do not re-drop Fab VaultCache / mega anim libraries into cooked Content
Content/Anims/

# Local-only config that should not be shared
Config/*Local*.ini

# Secrets / local OCI + Terraform state (never commit)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
*_oci
*_oci.pub
!infra/oci/terraform.tfvars.example
infra/oci/terraform.tfvars
infra/oci/terraform.tfvars.json
infra/oci/.terraform/
infra/oci/tfplan
infra/oci/*.tfstate
infra/oci/*.tfstate.*
infra/oci/crash.log
infra/oci/crash.*.log
# Keep infra/oci/.terraform.lock.hcl committed for reproducible provider versions.
